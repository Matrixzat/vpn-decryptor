name = "reversalx-vpn-decode-bot"
main = "worker.js"
compatibility_date = "2026-08-28"

# Store these with `wrangler secret put`; never put real values in this file.
# TG_BOT_TOKEN       Telegram bot token from BotFather
# TG_WEBHOOK_SECRET  random webhook secret, 1-256 characters
# GH_TOKEN           GitHub token allowed to dispatch Matrixzat/vpn-decryptor

[triggers]
crons = ["* * * * *"]

[[kv_namespaces]]
binding = "MESSAGE_CLEANUP"
id = "2380a8a9705b4e4b9c427c6a6377bc90"